VITE_SUPABASE_URL=<replace_me>
VITE_SUPABASE_ANON_KEY=<replace_me>

# Optional. Both have working defaults, so leave them unset unless you are
# pulling results from a ddr.tools instance other than the public one.

# PartyKit host serving ddr.tools event room state.
# Default: ddr-card-draw-party.noahm.partykit.dev
# Set this to point at a local ddr.tools dev server (`npx partykit dev`);
# a host starting with "localhost" is contacted over http instead of https.
# Note that only the room name is taken from the link pasted into the pull
# dialog — the host always comes from here.
# VITE_DDRTOOLS_PARTY_HOST=localhost:1999

# Base URL for song jackets referenced by imported charts. Stored on each
# imported stage, so changing it later won't rewrite existing rows.
# Default: https://ddr.tools/jackets
# VITE_DDRTOOLS_JACKET_BASE=http://localhost:8080/jackets
